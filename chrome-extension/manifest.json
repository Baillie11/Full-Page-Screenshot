{
  "manifest_version": 3,
  "name": "Full Page Screenshot",
  "version": "1.0.0",
  "description": "Capture full-page screenshots of any webpage with one click",
  "permissions": [
    "activeTab",
    "debugger",
    "downloads",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture Full Page Screenshot"
  },
  "background": {
    "service_worker": "background.js"
  }
}
